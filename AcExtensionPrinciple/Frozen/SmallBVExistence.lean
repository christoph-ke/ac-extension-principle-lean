/-- External input E1 (a hypothesis of `MainTheoremStatement`, not an axiom): universal
small-data existence and strict ε-parametrized estimates, in the original Christodoulou BV class.
Paper `203e554`, `lem:small-bv-existence`, lines 1358–1382;
Luk–Oh Thm. 5.12, (5-29)–(5-31), Rem. 5.13, footnote 13, p. 1633;
Christodoulou Thm. 6.2, p. 1183, with its proof pp. 1183–1197.
Data are right-continuous on [0,∞), with TV on (0,∞). No scalar-value
normalization, decay at infinity, or geodesic completeness is required. -/
@[expose] def SmallBVExistence : Prop :=
  ∃ ε₀ : ℝ, 0 < ε₀ ∧ ∃ C₀ : ℝ, 0 < C₀ ∧
    ∀ ε ∈ Ioo 0 ε₀, ∀ α₀ : ℝ → ℝ,
      (∀ v ∈ Ici (0 : ℝ), ContinuousWithinAt α₀ (Ici v) v) →
      eVariationOn α₀ (Ioi 0) < ENNReal.ofReal ε →
      ∃ S : SSFields, ChristodoulouBV smallBVDomain (Ici 0) S ∧
        (∀ v > 0, S.r 0 v = v / 2 ∧ S.dvpsi 0 v = α₀ v) ∧
        SmallBVGeometry S ∧
        (∀ u ≥ 0, smallBVOutgoingTV S u < ENNReal.ofReal (C₀ * ε)) ∧
        (∀ v > 0, smallBVIncomingTV S v < ENNReal.ofReal (C₀ * ε))

end AcExtensionPrinciple

