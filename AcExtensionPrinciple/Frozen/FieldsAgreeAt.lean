@[expose] def FieldsAgreeAt (S₁ S₂ : SSFields) (p : ℝ × ℝ) : Prop :=
  S₁.r p.1 p.2 = S₂.r p.1 p.2 ∧ S₁.phi p.1 p.2 = S₂.phi p.1 p.2 ∧
  S₁.m p.1 p.2 = S₂.m p.1 p.2 ∧ S₁.lam p.1 p.2 = S₂.lam p.1 p.2 ∧
  S₁.nu p.1 p.2 = S₂.nu p.1 p.2 ∧ S₁.dvpsi p.1 p.2 = S₂.dvpsi p.1 p.2 ∧
  S₁.dupsi p.1 p.2 = S₂.dupsi p.1 p.2

