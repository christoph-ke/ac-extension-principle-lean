/-- Integral equations, scalar AC, and axis conditions independent of uniform
bounds. Paper `203e554`, lines 66–84 and 214–269, Q8; Christodoulou
(1.7a,b), (1.14a,b), (1.15a,b), (1.18a,b), pp. 1135–1138,
and definition items 2, 3 (AC), 4, 6 on pp. 1146–1147.
One-sided limits are along the outgoing ray within D, so total-function
values outside the solution domain have no role. -/
structure ChrBVCore (D : Set (ℝ × ℝ)) (A : Set ℝ) (S : SSFields) : Prop where
  off_axis : D ⊆ {p | p.1 < p.2}
  radius_out : ∀ u a b, a ≤ b → outSeg u a b ⊆ D →
    IntervalPrimitive (S.r u) (S.lam u) a b
  radius_in : ∀ v a b, a ≤ b → inSeg v a b ⊆ D →
    IntervalPrimitive (fun u => S.r u v) (fun u => S.nu u v) a b
  psi_out : ∀ u a b, a ≤ b → outSeg u a b ⊆ D →
    IntervalPrimitive (fun v => S.r u v * S.phi u v) (S.dvpsi u) a b
  psi_in : ∀ v a b, a ≤ b → inSeg v a b ⊆ D →
    IntervalPrimitive (fun u => S.r u v * S.phi u v) (fun u => S.dupsi u v) a b
  mass_out : ∀ u a b, a ≤ b → outSeg u a b ⊆ D →
    IntervalPrimitive (S.m u) (S.massV u) a b
  mass_in : ∀ v a b, a ≤ b → inSeg v a b ⊆ D →
    IntervalPrimitive (fun u => S.m u v) (fun u => S.massU u v) a b
  lam_in : ∀ v a b, a ≤ b → inSeg v a b ⊆ D →
    IntervalPrimitive (fun u => S.lam u v) (fun u => S.radiusCoeff u v) a b
  nu_out : ∀ u a b, a ≤ b → outSeg u a b ⊆ D →
    IntervalPrimitive (S.nu u) (S.radiusCoeff u) a b
  dvpsi_in : ∀ v a b, a ≤ b → inSeg v a b ⊆ D →
    IntervalPrimitive (fun u => S.dvpsi u v) (fun u => S.radiusCoeff u v * S.phi u v) a b
  dupsi_out : ∀ u a b, a ≤ b → outSeg u a b ⊆ D →
    IntervalPrimitive (S.dupsi u) (fun v => S.radiusCoeff u v * S.phi u v) a b
  scalar_ac_out : ∀ u a b, a ≤ b → outSeg u a b ⊆ D →
    AbsolutelyContinuousOnInterval (S.phi u) a b
  scalar_ac_in : ∀ v a b, a ≤ b → inSeg v a b ⊆ D →
    AbsolutelyContinuousOnInterval (fun u => S.phi u v) a b
  radius_axis_limit : ∀ a ∈ A,
    Tendsto (S.r a) (𝓝[>] a ⊓ 𝓟 {v | (a, v) ∈ D}) (𝓝 0)
  mass_axis_limit : ∀ a ∈ A,
    Tendsto (S.m a) (𝓝[>] a ⊓ 𝓟 {v | (a, v) ∈ D}) (𝓝 0)
  expansion_axis_limit : ∀ a ∈ A,
    Tendsto (fun v => S.nu a v + S.lam a v)
      (𝓝[>] a ⊓ 𝓟 {v | (a, v) ∈ D}) (𝓝 0)
  scalar_axis_variation : ∀ a ∈ A, ChrAxisVanishingVariation D S a
  psi_axis_limit : ∀ a ∈ A,
    Tendsto (fun v => S.dvpsi a v + S.dupsi a v)
      (𝓝[>] a ⊓ 𝓟 {v | (a, v) ∈ D}) (𝓝 0)
  /-- BV representative convention: the BV fields are right-continuous in their BV direction (items
  1 and 5: λ, θ in v; ν, ζ in u; equivalently, since φ is continuous off Γ, λ, ∂ᵥψ = θ + λφ in v and
  ν, ∂ᵤψ = ζ + νφ in u, as stated in the paper, line 269). Sources: Luk–Oh pp. 1608–1609 ("functions
  of bounded variation … will be assumed to be right-continuous"); for Christodoulou's constructed
  solutions: ν, β adjusted to be right-continuous in u (p. 1196), α(u,·) right-continuous (p. 1197),
  λ continuous except on Γ (p. 1198), φ continuous off Γ (p. 1185). -/
  lam_right_cont : ∀ p ∈ D, ContinuousWithinAt (S.lam p.1) {w | p.2 ≤ w ∧ (p.1, w) ∈ D} p.2
  theta_right_cont : ∀ p ∈ D, ContinuousWithinAt (S.theta p.1) {w | p.2 ≤ w ∧ (p.1, w) ∈ D} p.2
  nu_right_cont : ∀ p ∈ D,
    ContinuousWithinAt (fun s => S.nu s p.2) {s | p.1 ≤ s ∧ (s, p.2) ∈ D} p.1
  zeta_right_cont : ∀ p ∈ D,
    ContinuousWithinAt (fun s => S.zeta s p.2) {s | p.1 ≤ s ∧ (s, p.2) ∈ D} p.1

end AcExtensionPrinciple

