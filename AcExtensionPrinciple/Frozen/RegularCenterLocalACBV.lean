/-- Regular-center additions to the local BV class. Paper `203e554`,
lines 114 and 214–269, `eq:regular-axis`, `eq:regular-axis-one-sided-traces`,
`eq:regular-axis-scalar-traces`. -/
structure RegularCenterLocalACBV (ui : ℝ) (S : SSFields) : Prop where
  localBV : LocalBVSolution (pastTriangle ui) S
  continuous_nu : ContinuousOn (fun p => S.nu p.1 p.2) (pastTriangle ui)
  axis_expansions : ∀ a, (a, a) ∈ axis ui → S.nu a a = -S.lam a a
  /-- Outgoing normalized v derivative trace: (∂ᵥψ/λ)(a,a+ε) → φ(a,a) as ε ↓ 0.
  Paper `203e554`, lines 241–249, `eq:regular-axis-one-sided-traces` (first limit). -/
  axis_dvpsi_out : ∀ a, (a, a) ∈ axis ui →
    Tendsto (fun ε => S.dvpsi a (a + ε) / S.lam a (a + ε))
      (𝓝[>] 0) (𝓝 (S.phi a a))
  /-- Outgoing normalized u derivative trace: (∂ᵤψ/ν)(a,a+ε) → φ(a,a) as ε ↓ 0.
  Paper `203e554`, lines 241–249, `eq:regular-axis-one-sided-traces` (second limit). -/
  axis_dupsi_out : ∀ a, (a, a) ∈ axis ui →
    Tendsto (fun ε => S.dupsi a (a + ε) / S.nu a (a + ε))
      (𝓝[>] 0) (𝓝 (S.phi a a))
  /-- Incoming normalized v derivative trace: (∂ᵥψ/λ)(a−ε,a) → φ(a,a) as ε ↓ 0, ε restricted
  to (a−ε,a) ∈ 𝒬. Paper `203e554`, lines 241–250, `eq:regular-axis-one-sided-traces`
  (third limit). At the initial vertex a = u_i the filter is bottom: the paper imposes only the
  first two limits there (line 250). -/
  axis_dvpsi_in : ∀ a, (a, a) ∈ axis ui →
    Tendsto (fun ε => S.dvpsi (a - ε) a / S.lam (a - ε) a)
      (𝓝[>] 0 ⊓ 𝓟 {ε | ui ≤ a - ε}) (𝓝 (S.phi a a))
  /-- Incoming normalized u derivative trace: (∂ᵤψ/ν)(a−ε,a) → φ(a,a) as ε ↓ 0, ε restricted
  to (a−ε,a) ∈ 𝒬. Paper `203e554`, lines 241–250, `eq:regular-axis-one-sided-traces`
  (fourth limit). At the initial vertex a = u_i the filter is bottom (line 250). -/
  axis_dupsi_in : ∀ a, (a, a) ∈ axis ui →
    Tendsto (fun ε => S.dupsi (a - ε) a / S.nu (a - ε) a)
      (𝓝[>] 0 ⊓ 𝓟 {ε | ui ≤ a - ε}) (𝓝 (S.phi a a))
  /-- The axis values themselves, `eq:regular-axis-scalar-traces` (lines 251–256):
  (∂ᵥψ/λ)(u,u) = φ(u,u). The one-sided limits alone do not fix the stored value on the
  axis. -/
  axis_dvpsi_value : ∀ a, (a, a) ∈ axis ui → S.dvpsi a a / S.lam a a = S.phi a a
  /-- `eq:regular-axis-scalar-traces` (lines 251–256): (∂ᵤψ/ν)(u,u) = φ(u,u). -/
  axis_dupsi_value : ∀ a, (a, a) ∈ axis ui → S.dupsi a a / S.nu a a = S.phi a a

end AcExtensionPrinciple

