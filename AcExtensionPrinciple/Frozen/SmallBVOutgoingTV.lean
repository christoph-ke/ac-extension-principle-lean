/-- Sum of the three outgoing TVs on the off-axis ray (u,∞).
Paper `203e554`, `lem:small-bv-existence`, line 1381;
Luk–Oh (5-30), p. 1633, BV interval convention pp. 1608–1609. -/
@[expose] noncomputable def smallBVOutgoingTV (S : SSFields) (u : ℝ) : ℝ≥0∞ :=
  eVariationOn (fun v => S.dvpsi u v / S.lam u v) (Ioi u) +
  eVariationOn (S.phi u) (Ioi u) +
  eVariationOn (fun v => Real.log (S.lam u v)) (Ioi u)

end AcExtensionPrinciple

