/-- Radius transport coefficient. Paper `203e554`, `eq:radius`,
Luk–Oh (2-6). It is the common right-hand side ∂ᵥν = ∂ᵤλ = κϰν. -/
@[expose] noncomputable def radiusCoeff (S : SSFields) (u v : ℝ) : ℝ :=
  S.mu u v * S.lam u v * S.nu u v / ((1 - S.mu u v) * S.r u v)

