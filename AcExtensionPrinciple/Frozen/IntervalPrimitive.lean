/-- An interval primitive with its integrability assertion.
Paper `203e554`, lines 66–84 and 216 (ruling Q8). -/
@[expose] def IntervalPrimitive (f g : ℝ → ℝ) (a b : ℝ) : Prop :=
  IntervalIntegrable g MeasureTheory.volume a b ∧ f b - f a = ∫ s in a..b, g s

