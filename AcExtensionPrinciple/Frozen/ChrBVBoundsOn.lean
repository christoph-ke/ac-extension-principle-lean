/-- Uniform bounds on the whole characteristic-line portions in K ∩ D.
Paper `203e554`, lines 214–269, Q6; Christodoulou pp. 1146–1147,
infimum conditions and items 1, 3 (TV), 5. The scalar amplitudes are
θ = r∂ᵥφ and ζ = r∂ᵤφ, rather than α and β. -/
structure ChrBVBoundsOn (K D : Set (ℝ × ℝ)) (S : SSFields) : Prop where
  expansion_bounds : ∃ c N : ℝ, 0 < c ∧
    ∀ p ∈ K ∩ D, c ≤ S.lam p.1 p.2 ∧ -S.nu p.1 p.2 ≤ N
  variation_bounds : ∃ C : ℝ,
    (∀ u, eVariationOn (S.lam u) {v | (u, v) ∈ K ∩ D} ≤ ENNReal.ofReal C ∧
      eVariationOn (S.phi u) {v | (u, v) ∈ K ∩ D} ≤ ENNReal.ofReal C ∧
      eVariationOn (S.theta u) {v | (u, v) ∈ K ∩ D} ≤ ENNReal.ofReal C) ∧
    (∀ v, eVariationOn (fun u => S.nu u v) {u | (u, v) ∈ K ∩ D} ≤ ENNReal.ofReal C ∧
      eVariationOn (fun u => S.phi u v) {u | (u, v) ∈ K ∩ D} ≤ ENNReal.ofReal C ∧
      eVariationOn (fun u => S.zeta u v) {u | (u, v) ∈ K ∩ D} ≤ ENNReal.ofReal C)

end AcExtensionPrinciple

end
